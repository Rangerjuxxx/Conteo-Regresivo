<!DOCTYPE html>
<html lang="es"> 
<head> 
    <meta charset="UTF-8"> 
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VIAJECITO A PARRAS</title>
    <style>
        /* Estilos generales */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            margin: 0; 
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #1a1a1a;
            color: #fff;
        }

        /* Contenedor principal */
        .contenedor {
            text-align: center;
            background: linear-gradient(135deg, #2c3e50, #34495e);
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        /* Título */
        h1 {
            font-size: 2.5em;
            margin-bottom: 20px;
            color: #ecf0f1;
        }

        /* Fechas */
        .fechas {
            font-size: 1.2em;
            margin-bottom: 30px;
            color: #bdc3c7;
        }

        /* Contador */
        #conteo {
            font-size: 3em;
            font-weight: bold;
            color: #e74c3c;
            text-shadow: 0 0 10px rgba(231, 76, 60, 0.7);
        }

        /* Detalles del contador */
        #conteo span {
            font-size: 0.6em;
            color: #ecf0f1;
        }

        /* Efecto de brillo */
        @keyframes brillo {
            0% { text-shadow: 0 0 10px rgba(231, 76, 60, 0.7); }
            50% { text-shadow: 0 0 20px rgba(231, 76, 60, 1); }
            100% { text-shadow: 0 0 10px rgba(231, 76, 60, 0.7); }
        }

        #conteo {
            animation: brillo 2s infinite;
        }
    </style>
</head>


<body>
    <div class="contenedor">
        <h1>POSADA CABAÑA 2025</h1>
        <div class="fechas"> 
            <p>Fecha del viaje: <strong>6 de diciembre de 2025</strong></p>
        </div>
        <div id="conteo">Cargando...</div> 
    </div>

    <script>
        // Fecha de inicio (29 de octubre de 2025)
        const fechaInicio = new Date('2025-10-29T00:00:00');

        // Fecha del viaje (6 de diciembre de 2025)
        const fechaViaje = new Date('2025-12-06T00:00:00');

        function actualizarConteo() {
            // Obtener la fecha y hora actual
            const ahora = new Date();

            // Si la fecha actual es anterior al 29 de octubre de 2025, mostrar un mensaje
            if (ahora < fechaInicio) {
                document.getElementById('conteo').innerHTML = "El conteo comenzará el <strong>29 de octubre de 2025</strong>.";
                return;
            }

            // Calcular la diferencia en milisegundos
            const diferencia = fechaViaje - ahora;

            // Si la fecha del viaje ya pasó, mostrar un mensaje
            if (diferencia <= 0) {
                document.getElementById('conteo').innerHTML = "¡El viaje ya comenzó!";
                return;
            }

            // Calcular días, horas, minutos y segundos
            const dias = Math.floor(diferencia / (1000 * 60 * 60 * 24));
            const horas = Math.floor((diferencia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutos = Math.floor((diferencia % (1000 * 60 * 60)) / (1000 * 60));
            const segundos = Math.floor((diferencia % (1000 * 60)) / 1000);

            // Mostrar el resultado
            document.getElementById('conteo').innerHTML =
                `Restan: <br>
                <span>${dias}</span> días <br>
                <span>${horas}</span> horas <br>
                <span>${minutos}</span> minutos <br>
                <span>${segundos}</span> segundos`;
        }

        // Actualizar el conteo al cargar la página
        actualizarConteo();

        // Actualizar el conteo cada segundo
        setInterval(actualizarConteo, 1000);
    </script>
</body>
</html>
